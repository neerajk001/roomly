# core
APP_URL=http://localhost:3001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/roomdesigner
# Optional direct (non-pooled) URL for pg-boss. Leave empty when DATABASE_URL
# is already a direct connection (the normal VPS setup).
QUEUE_DATABASE_URL=
# Web and worker must match. Browser tests use pgboss_e2e to isolate fake renders.
QUEUE_SCHEMA=pgboss

# auth (email OTP + Google only; passwords are disabled)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google redirect URI: {APP_URL}/api/auth/callback/google
# Unused by OTP auth; kept for the env schema.
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Dev only: skip sign-in locally (never enable in production)
DEV_AUTH_BYPASS=false

# storage
# s3 = local MinIO/CI, cloudinary = production image CDN
STORAGE_PROVIDER=s3
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=roomdesigner
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# optional CDN base for public assets
S3_PUBLIC_BASE_URL=
WEB_RENDER_MAX_PX=2048

# ai
# fake | openai
IMAGE_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
ADVICE_PROVIDER=fake
# Choose a vision/text model explicitly before enabling ADVICE_PROVIDER=openai.
OPENAI_ADVICE_MODEL=
# Conservative accounting allowance in USD micros per advice call (including failures).
# Configure against the chosen model's pricing; this is not a hard provider billing cap.
ADVICE_CALL_BUDGET_MICROS=250000
MAX_DAILY_SPEND_USD=5
SIGNUP_FREE_CREDITS=3

# email
# console | resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=

# billing (V5)
BILLING_PROVIDER=
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=

# observability (V6)
SENTRY_DSN=

# worker health probe (Docker HEALTHCHECK / uptime checks; 0 disables it)
WORKER_HEALTH_PORT=3002
