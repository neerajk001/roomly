# Environment for the Hostinger VPS stack (host Nginx + web + worker).
# Copy to /opt/roomdesigner/.env.production on the server. Never commit real values.

NODE_ENV=production

# Public domain served by host Nginx. Point the DNS A/AAAA record at the VPS.
DOMAIN=your-domain.com
# Must match the public HTTPS domain. Better Auth uses this for cookies + callbacks.
APP_URL=https://your-domain.com
BETTER_AUTH_URL=https://your-domain.com
# openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Neon Postgres for the VPS stack. Use the DIRECT (non-pooled) URL: pg-boss
# keeps long-lived connections and does not mix well with the transaction pooler.
# postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Optional pg-boss override. Leave empty; it falls back to DATABASE_URL.
QUEUE_DATABASE_URL=

# Google OAuth. Authorised redirect URI:
#   https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth is email OTP + Google only (no passwords).
# Kept for env-schema compatibility; OTP sign-in always verifies the email.
AUTH_REQUIRE_EMAIL_VERIFICATION=true
DEV_AUTH_BYPASS=false

# Image storage. Cloudinary is the production provider (signed uploads,
# private assets, time-limited signed delivery URLs). Local dev/CI uses
# STORAGE_PROVIDER=s3 with MinIO.
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional S3/R2 fallback. Uncomment and fill every S3_* value only when
# switching STORAGE_PROVIDER=s3.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=roomdesigner
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=
WEB_RENDER_MAX_PX=2048

# AI provider
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
# Suggestions/object detection stay explicitly in demo mode until configured.
ADVICE_PROVIDER=fake
OPENAI_ADVICE_MODEL=
# Conservative allowance per attempted analysis call, not a provider billing cap.
ADVICE_CALL_BUDGET_MICROS=250000
MAX_DAILY_SPEND_USD=5
SIGNUP_FREE_CREDITS=3

# Transactional email (OTP codes). Verify the domain in Resend first.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="RoomDesigner <no-reply@your-domain.com>"

# Worker health probe used by Docker (0 disables it)
WORKER_HEALTH_PORT=3002
