# Backend env for the Hostinger VPS worker.
# Copy to /opt/roomdesigner/.env.production on the server. Never commit real values.
# The same values (except S3/worker-only ones) go into the Vercel project env.

NODE_ENV=production

# Public site URL (Vercel domain). Better Auth uses this for cookies + callbacks.
APP_URL=https://your-domain.com
BETTER_AUTH_URL=https://your-domain.com
# openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Neon Postgres for the worker. Use the DIRECT (non-pooled) URL here: pg-boss
# keeps long-lived connections and does not mix well with the transaction pooler.
# The Vercel project uses the pooled URL instead.
# postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Optional. The worker's DATABASE_URL is already direct, so leave this empty
# here. On Vercel set it to the direct Neon URL (see .env.example).
QUEUE_DATABASE_URL=

# Google OAuth. Authorised redirect URI:
#   https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth is email OTP + Google only (no passwords).
# Kept for env-schema compatibility; OTP sign-in always verifies the email.
AUTH_REQUIRE_EMAIL_VERIFICATION=true
DEV_AUTH_BYPASS=false

# S3-compatible storage (Cloudflare R2 in production).
# R2 needs CORS allowing PUT from APP_URL for browser uploads.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=roomdesigner
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
WEB_RENDER_MAX_PX=2048

# AI provider
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
MAX_DAILY_SPEND_USD=5
SIGNUP_FREE_CREDITS=3

# Transactional email (OTP codes). Verify the domain in Resend first.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="RoomDesigner <no-reply@your-domain.com>"

# Billing (leave empty until enabled)
BILLING_PROVIDER=
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=

# Observability (optional)
SENTRY_DSN=

# Worker health probe used by Docker/uptime monitoring (0 disables it)
WORKER_HEALTH_PORT=3002
