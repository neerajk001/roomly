// RoomDesigner database schema.
// App models come from docs/spec/02-database.md.
// The Better Auth tables (User, Session, Account, Verification) are generated
// with `pnpm dlx auth@latest generate` and must not be hand-written. The only
// allowed manual edits on User: the back-relation fields and the `mode` field.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceType {
  PERSONAL
  STUDIO
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

enum RoomType {
  LIVING_ROOM
  BEDROOM
  KITCHEN
  BATHROOM
  DINING_ROOM
  HOME_OFFICE
  KIDS_ROOM
  BALCONY
  HALLWAY
  OTHER
}

enum AssetKind {
  ORIGINAL_PHOTO
  RENDER
  THUMBNAIL
  LOGO
  BRIEF_UPLOAD
}

enum RenderKind {
  RESTYLE
  EDIT
}

enum RenderStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum RateUnit {
  AREA_FLOOR
  AREA_CEILING
  AREA_WALL
  LENGTH_PERIMETER
  PER_UNIT
  LUMP_SUM
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  APPROVED
  CHANGES_REQUESTED
  EXPIRED
}

enum CommentAuthor {
  CLIENT
  DESIGNER
}

enum CreditReason {
  SIGNUP_GRANT
  PLAN_GRANT
  PURCHASE
  RENDER_RESERVE
  RENDER_REFUND
  ADJUSTMENT
}

enum BriefStatus {
  OPEN
  SUBMITTED
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

// ---- Better Auth tables (generated; do not hand-edit except User relations) ----

model User {
  id                   String            @id
  name                 String
  email                String
  emailVerified        Boolean           @default(false)
  image                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  mode                 String            @default("HOME")
  // Set once the /onboarding wizard completes; guards redirect when null.
  onboardedAt          DateTime?
  sessions             Session[]
  accounts             Account[]
  ownedWorkspaces      Workspace[]       @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---- App models ----

model Workspace {
  id             String        @id @default(cuid())
  name           String
  type           WorkspaceType @default(PERSONAL)
  ownerId        String
  owner          User          @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  currency       String        @default("USD") // ISO 4217
  unitSystem     UnitSystem    @default(METRIC)
  brandName      String?
  brandColor     String?
  logoStorageKey String?
  contactEmail   String?
  contactPhone   String?
  defaultTerms   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  members      WorkspaceMember[]
  clients      Client[]
  projects     Project[]
  assets       Asset[]
  rateCards    RateCard[]
  creditLedger CreditLedger[]
  briefLinks   BriefLink[]
  subscription Subscription?

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Client {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  notes       String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projects   Project[]
  briefLinks BriefLink[]

  @@index([workspaceId])
}

model Project {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name        String
  currency    String    @default("USD")
  budgetMinor Int?
  renterMode  Boolean   @default(false)
  keepList    String[]
  styleKey    String?
  notes       String?
  shareToken  String?   @unique
  // Share gallery mode: true = only favorited renders, false = all renders.
  shareShowFavorites Boolean @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rooms     Room[]
  estimates Estimate[]
  proposals Proposal[]

  @@index([workspaceId, createdAt])
}

model Room {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  type      RoomType @default(OTHER)
  // Dimensions are optional: homeowners often don't know them, and AI renders
  // never use them. They only improve estimates.
  widthMm   Int?
  lengthMm  Int?
  heightMm  Int?
  // [{ "type": "DOOR"|"WINDOW", "widthMm": n, "heightMm": n, "qty": n }]
  openings  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets     Asset[]
  renderJobs RenderJob[]
  estimates  Estimate[]

  @@index([projectId])
}

model Asset {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  roomId      String?
  room        Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  kind        AssetKind
  storageKey  String    @unique
  mime        String
  sizeBytes   Int
  width       Int?
  height      Int?
  confirmedAt DateTime? // set after upload confirmation
  createdAt   DateTime  @default(now())

  outputs   RenderOutput[]
  thumbFor  RenderOutput[] @relation("RenderThumb")
  sourceFor RenderJob[]    @relation("RenderSource")

  @@index([workspaceId, kind])
}

model RenderJob {
  id             String       @id @default(cuid())
  workspaceId    String
  roomId         String
  room           Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  kind           RenderKind
  status         RenderStatus @default(QUEUED)
  styleKey       String?
  instruction    String?
  params         Json         @default("{}")
  sourceAssetId  String
  sourceAsset    Asset        @relation("RenderSource", fields: [sourceAssetId], references: [id])
  parentJobId    String?
  parentJob      RenderJob?   @relation("RenderChain", fields: [parentJobId], references: [id])
  children       RenderJob[]  @relation("RenderChain")
  variations     Int          @default(4)
  provider       String
  model          String?
  creditsCharged Int
  costMicros     Int          @default(0)
  attempts       Int          @default(0)
  errorCode      String?
  errorMessage   String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime     @default(now())

  outputs RenderOutput[]

  @@index([workspaceId, createdAt])
  @@index([status])
}

model RenderOutput {
  id           String    @id @default(cuid())
  jobId        String
  job          RenderJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  assetId      String
  asset        Asset     @relation(fields: [assetId], references: [id])
  // V2 addition: the grid needs a small image per output.
  thumbAssetId String?
  thumbAsset   Asset?    @relation("RenderThumb", fields: [thumbAssetId], references: [id])
  index        Int
  isFavorite   Boolean   @default(false)
  votes        Int       @default(0) // from share-link votes (V3)
  createdAt    DateTime  @default(now())

  @@unique([jobId, index])
}

model CreditLedger {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  delta       Int // + grant/refund, - spend
  reason      CreditReason
  refId       String? // jobId, workspaceId (signup), or `${subId}:${periodStart}`
  note        String?
  createdAt   DateTime     @default(now())

  @@unique([reason, refId]) // idempotency for grants and refunds
  @@index([workspaceId, createdAt])
}

model RateCard {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  currency    String    @default("USD")
  markupBps   Int       @default(0)
  taxBps      Int       @default(0)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items     RateCardItem[]
  estimates Estimate[]

  @@index([workspaceId])
}

model RateCardItem {
  id             String   @id @default(cuid())
  rateCardId     String
  rateCard       RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  key            String
  label          String
  category       String
  unit           RateUnit
  unitPriceMinor Int
  sortOrder      Int      @default(0)

  @@unique([rateCardId, key])
}

model Estimate {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roomId        String?
  room          Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  rateCardId    String?
  rateCard      RateCard? @relation(fields: [rateCardId], references: [id], onDelete: SetNull)
  version       Int       @default(1)
  currency      String
  subtotalMinor Int
  markupMinor   Int
  taxMinor      Int
  totalMinor    Int
  rangeBps      Int? // set for rough Home estimates
  createdAt     DateTime  @default(now())

  lines     EstimateLine[]
  proposals Proposal[]

  @@index([projectId])
}

model EstimateLine {
  id             String   @id @default(cuid())
  estimateId     String
  estimate       Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  itemKey        String?
  label          String
  category       String
  unit           RateUnit
  quantity       Decimal  @db.Decimal(12, 2)
  unitPriceMinor Int
  totalMinor     Int
  sortOrder      Int      @default(0)

  @@index([estimateId])
}

model Proposal {
  id               String         @id @default(cuid())
  projectId        String
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  estimateId       String
  estimate         Estimate       @relation(fields: [estimateId], references: [id])
  version          Int            @default(1)
  status           ProposalStatus @default(DRAFT)
  title            String
  intro            String?
  terms            String?
  renderOutputIds  String[] // ordered options shown to the client
  optionCaptions   Json     @default("{}")
  approvedByName   String?
  publicToken      String         @unique
  expiresAt        DateTime?
  sentAt           DateTime?
  viewedAt         DateTime?
  approvedAt       DateTime?
  approvedOutputId String?
  pdfStorageKey    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  comments ProposalComment[]

  @@index([projectId])
}

model ProposalComment {
  id         String        @id @default(cuid())
  proposalId String
  proposal   Proposal      @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  authorType CommentAuthor
  authorName String
  body       String
  createdAt  DateTime      @default(now())

  @@index([proposalId])
}

model BriefLink {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  token       String      @unique
  status      BriefStatus @default(OPEN)
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())

  submissions BriefSubmission[]

  @@index([workspaceId])
}

model BriefSubmission {
  id          String    @id @default(cuid())
  briefLinkId String
  briefLink   BriefLink @relation(fields: [briefLinkId], references: [id], onDelete: Cascade)
  answers     Json
  assetIds    String[]
  projectId   String? // draft project created from the submission
  createdAt   DateTime  @default(now())
}

model Subscription {
  id                     String             @id @default(cuid())
  workspaceId            String             @unique
  workspace              Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider               String
  providerCustomerId     String
  providerSubscriptionId String?            @unique
  plan                   String
  status                 SubscriptionStatus
  currentPeriodEnd       DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

model WebhookEvent {
  id          String   @id // provider event id
  provider    String
  type        String
  processedAt DateTime @default(now())
}
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}
